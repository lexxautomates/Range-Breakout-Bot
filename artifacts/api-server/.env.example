## API server
PORT=8080
# Bind address for the API server. Use 127.0.0.1 for local-only, or 0.0.0.0 for LAN/Docker.
HOST=127.0.0.1

## Dashboard <-> API
# If set, browser requests are allowed only from this exact origin (example: http://localhost:8081)
# If unset, CORS is disabled (non-browser clients like curl still work).
DASHBOARD_ORIGIN=http://localhost:8081

## API Authentication
# Required for non-localhost access. Use a long random value.
API_TOKEN=change-me

## Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/range_breakout

## Brokers / data providers (optional unless you enable them)
ALPACA_API_KEY=
ALPACA_API_SECRET=
CRYPTOCOM_API_KEY=
CRYPTOCOM_API_SECRET=

## LLM advisor (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

## Market news (optional)
AUTOCLI_API_TOKEN=
